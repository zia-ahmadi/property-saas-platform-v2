# Example environment file for the F8 deployment stack.
#
#   cp .env.example .env    # then replace every placeholder with a real value
#
# `.env` is git-ignored; never commit real secrets.

# --- Required secrets --------------------------------------------------------
# Generate with:  openssl rand -base64 48
POSTGRES_PASSWORD=replace-with-a-strong-database-password
# Must decode to at least 32 bytes of Base64 (HS256 signing key).
# Generate with:  openssl rand -base64 32
JWT_SECRET=replace-with-a-base64-32-byte-jwt-secret
# Must decode to at least 32 bytes of Base64 (CSRF HMAC key).
# Generate with:  openssl rand -base64 32
BROWSER_CSRF_SECRET=replace-with-a-base64-32-byte-csrf-secret

# --- Database ----------------------------------------------------------------
POSTGRES_DB=property_management
POSTGRES_USER=property_admin

# --- Public origin and profiles ---------------------------------------------
# Exact Origin the browser uses. Local HTTP development keeps the development
# cookie mode; production must use https:// and no SPRING_PROFILES_ACTIVE.
PUBLIC_ORIGIN=http://localhost:8080
SPRING_PROFILES_ACTIVE=development

# Host port for the SPA (the only published port).
FRONTEND_PORT=8080

# Leave empty so the SPA calls its own origin (/api proxied by Nginx). Set it
# only when the API lives on a different origin, e.g. https://api.example.com.
API_BASE_URL=
